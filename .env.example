# Copy this file to .env in this folder and fill in your own key:
#     cp .env.example .env
#
# .env is gitignored. Never commit a real key.

# Portkey API key — the agents reach the model through Portkey's
# OpenAI-compatible gateway.
PORTKEY_API_KEY=your-portkey-api-key-here

# The only model the five agents use.
CAMPUS_CUSTOMS_MODEL=gpt-6-luna

# Portkey gateway base URL. Leave as-is unless you use a different gateway.
PORTKEY_BASE_URL=https://api.portkey.ai/v1
